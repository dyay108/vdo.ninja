# ---------------------------------------------------------------------------
# VDO.Ninja - nginx site config (envsubst template)
#
# Rendered to /etc/nginx/conf.d/default.conf at container start by the base
# image's 20-envsubst-on-templates.sh. Only ${VDO_PORT} is substituted -
# NGINX_ENVSUBST_FILTER is set to ^VDO_ in the Dockerfile so that nginx's own
# runtime variables ($uri, $request_uri, $1 ...) are left untouched.
#
# Serves the static client as a non-root user. TLS, HTTP/2 and the public
# hostname are all handled by the reverse proxy in front of this container.
#
# Routing rules follow upstream's install.md so that extensionless URLs
# (/mixer, /obs/simple) resolve the same way they do on vdo.ninja.
# ---------------------------------------------------------------------------

# Cache policy keyed off the request path. First matching regex wins.
#
# Markup and JSON stay revalidated so a redeploy is visible immediately.
# Code gets a short TTL: most of it is already cache-busted with ?ver= in the
# HTML, but a few module imports (core/, podcast/) are not, and a long TTL
# would strand those on an old build after an update.
# Media, fonts and model weights effectively never change, so they cache hard.
map $uri $vdo_cache_control {
    default                                     "no-cache";
    ~*\.(?:js|mjs|css)$                         "public, max-age=3600";
    ~*\.(?:png|jpe?g|gif|webp|avif|svg|ico)$    "public, max-age=2592000";
    ~*\.(?:woff2?|ttf|otf|eot)$                 "public, max-age=2592000";
    ~*\.(?:wasm|bin|tflite|task|data)$          "public, max-age=2592000";
    ~*\.(?:mp3|mp4|webm|ogg|wav|m4a)$           "public, max-age=2592000";
}

server {
    listen      ${VDO_PORT};
    listen      [::]:${VDO_PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # The proxy in front of us owns the scheme, host and port. Without these,
    # the /foo.html -> /foo redirect below would go out as
    # "http://<container-id>:${VDO_PORT}/foo" and leak the internal port to
    # the browser, which then fails to resolve it.
    absolute_redirect off;
    port_in_redirect  off;

    sendfile    on;
    tcp_nopush  on;

    # --- compression -------------------------------------------------------
    # .gz siblings are generated at image build time, so the large payloads
    # (lib.js is 2.2 MB, webrtc.js 726 KB) are served straight off disk with
    # no per-request CPU. gzip covers anything that was not precompressed.
    gzip_static     on;
    gzip            on;
    gzip_vary       on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/markdown
        text/javascript
        application/javascript
        application/json
        application/xml
        application/manifest+json
        image/svg+xml;

    # --- headers -----------------------------------------------------------
    # These are set at server level ONLY. An add_header anywhere inside a
    # location block replaces the entire inherited set rather than adding to
    # it, so the locations below deliberately declare none of their own.
    #
    # Deliberately NOT set, because each one breaks a core feature:
    #   X-Frame-Options         - kills OBS browser sources and the IFRAME API.
    #   Content-Security-Policy - the app uses inline script throughout.
    #   COOP / COEP             - blocks cross-origin embeds and third-party
    #                             asset loads.
    add_header Access-Control-Allow-Origin "*"     always;
    add_header X-Content-Type-Options      "nosniff" always;
    add_header Referrer-Policy             "strict-origin-when-cross-origin" always;

    # Permits camera/mic to be delegated down into nested iframes. Without a
    # policy the top-level page still works, but embedded VDO.Ninja instances
    # lose device access in some browsers.
    add_header Permissions-Policy
        "camera=*, microphone=*, display-capture=*, autoplay=*, fullscreen=*" always;

    add_header Cache-Control $vdo_cache_control always;

    # --- routing -----------------------------------------------------------

    # Container health probe. Exact-match wins over the regex location below.
    location = /healthz {
        access_log   off;
        default_type text/plain;
        return 200   "ok\n";
    }

    # Serve the conferencing wrapper at the root instead of the stock
    # VDO.Ninja landing page.
    #
    # `location = /` is an exact match, so it catches only the bare root and
    # never the assets - /main.js, /lib.js and /call-theme.css all still fall
    # through to `location /` below. Doing the same thing in a reverse proxy
    # by rewriting the path prefix would catch those too and break them.
    #
    # Rewriting rather than redirecting keeps the URL at "/", which matters
    # because the wrapper builds its invite links from window.location - a
    # redirect would make every shared link carry the /call path. Query
    # strings are unaffected by location matching, so /?room=xyz still lands
    # here and still reaches the page with its query intact.
    #
    # The stock landing page is still reachable at /index.
    location = / {
        try_files /call.html =404;
    }

    # Two-segment paths such as /obs/simple, /examples/control, /whip/index.
    # Tries the literal file first, then its .html form, then the directory,
    # then the same name at the root, before falling back to the subdirectory
    # index. Deeper paths fall through to location / below.
    location ~ ^/([^/]+)/([^/?]+)$ {
        try_files /$1/$2 /$1/$2.html /$1/$2/ /$2 /$2/ /$1/index.html;
    }

    location / {
        # Collapse /mixer.html to /mixer so each page has one canonical URL.
        if ($request_uri ~ ^/(.*)\.html$) {
            return 302 /$1;
        }
        try_files $uri $uri.html $uri/ /index.html;
    }
}
